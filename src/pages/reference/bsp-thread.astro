import AdSlot from '../../components/AdSlot.astro';
const rows = [
  ['G 1/8','9.728','28','0.907'],['G 1/4','13.157','19','1.337'],['G 3/8','16.662','19','1.337'],['G 1/2','20.955','14','1.814'],['G 5/8','22.911','14','1.814'],['G 3/4','26.441','14','1.814'],['G 1','33.249','11','2.309'],['G 1 1/4','41.910','11','2.309'],['G 1 1/2','47.803','11','2.309'],['G 2','59.614','11','2.309']
