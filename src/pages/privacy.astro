---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Privacy Policy" description="Privacy policy placeholder for Hydraulic Toolbox.">
  <section class="page-hero"><div class="container"><span class="eyebrow">Legal</span><h1 style="font-size:clamp(2.4rem,6vw,4.7rem);margin-top:12px">Privacy policy</h1><p class="lead">Pre-launch placeholder. Replace with a jurisdiction-appropriate policy before enabling analytics, advertising, payments or user uploads.</p></div></section>
  <section class="section compact"><div class="container article"><h2>Before launch</h2><p>This project currently contains no live analytics, advertising network code, payments or upload backend. When those services are added, document the data they collect, retention, processors, cookies, consent controls and user rights.</p></div></section>
</BaseLayout>
